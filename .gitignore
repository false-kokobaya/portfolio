# ===========================================
# ログ・デバッグ出力（実行時に生成されるログ類）
# ===========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Node の診断レポート
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ===========================================
# 依存関係（パッケージインストール先・再生成可能）
# ===========================================
node_modules/
jspm_packages/
bower_components/
web_modules/

# Yarn v3 の PnP 関連
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# ===========================================
# ビルド成果物（npm run build で生成される出力）
# ===========================================
dist/

# その他フレームワークのビルド出力
.next
out
.nuxt
build/Release
.vuepress/dist
**/.vitepress/dist
.docusaurus

# ===========================================
# 環境変数（秘密情報を含むためリポジトリに含めない）
# .env.example だけはコミットしてテンプレートとして残す
# ===========================================
.env
.env.*
!.env.example

# ===========================================
# キャッシュ・一時ファイル（ツールのキャッシュで再生成可能）
# ===========================================
.cache
.parcel-cache
.eslintcache
.stylelintcache
.npm
*.tsbuildinfo
**/.vitepress/cache
.temp
.fusebox/
.serverless/
.firebase/
.vite/cache

# Vite のタイムスタンプ付き一時ファイル
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ===========================================
# テスト・カバレッジ（テスト実行で生成されるレポート）
# ===========================================
coverage
*.lcov
.nyc_output
lib-cov

# ===========================================
# OS・エディタ固有（開発環境ごとの設定・一時ファイル）
# ===========================================
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains（IntelliJ, WebStorm 等）のプロジェクト設定
.idea/
*.iml
*.ipr
*.iws

# VSCode のテスト用（拡張開発時）
.vscode-test

# ===========================================
# その他（ランタイム・パッケージング・レガシー）
# ===========================================
# プロセスID等のランタイムデータ
pids
*.pid
*.seed
*.pid.lock

# Grunt / node-waf 等のレガシーツール
.grunt
.lock-wscript

# Node のネイティブアドオンビルド
build/Release

# npm pack の出力
*.tgz

# REPL の履歴
.node_repl_history

# TernJS
.tern-port

# DynamoDB Local
.dynamodb/

# SvelteKit
.svelte-kit/
